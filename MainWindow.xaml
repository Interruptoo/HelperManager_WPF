<Window x:Class="HelperManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:modules="clr-namespace:HelperManager.Modules"
        mc:Ignorable="d"
        Title="HelperManager" Height="750" Width="1280"
        WindowStartupLocation="CenterScreen"
        Icon="Images/Logo.png"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!--
            좌측 네비게이션 메뉴 항목 하나(아이콘 + 제목)를 표시하는 템플릿.
            메뉴가 접혀 아이콘만 보일 때(VS Code 사이드바처럼)도 어떤 화면인지 알 수 있도록
            항상 ToolTip 으로 제목을 보여주고, 제목 텍스트는 메뉴가 펼쳐졌을 때만 표시한다.
        -->
        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type modules:IFeatureModule}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding Title}">
                <TextBlock Text="{Binding IconGlyph}" FontSize="16" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="14">
                    <TextBlock.Visibility>
                        <Binding Path="DataContext.IsMenuExpanded"
                                 RelativeSource="{RelativeSource AncestorType=Window}"
                                 Converter="{StaticResource BoolToVisibilityConverter}" />
                    </TextBlock.Visibility>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- 네비게이션 ListBoxItem 스타일: 선택 시 은은한 배경색으로 강조 -->
        <Style x:Key="NavListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="6"
                                Margin="6,3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.NavSelected}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F0F3F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- IsMenuExpanded 에 따라 220px(펼침) <-> 56px(VS Code 사이드바처럼 아이콘만 보이는 레일)로 접힌다. -->
            <ColumnDefinition Width="{Binding IsMenuExpanded, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter='220,57'}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== 좌측: 메인 네비게이션 메뉴 ===================== -->
        <!-- 이 메뉴는 IFeatureModule 목록만 바라보므로, 화면(모듈)이 추가되어도 수정할 필요가 없다. -->
        <!-- 접혔을 때도 Border 자체는 남겨두고(ListBox 는 그대로 아이콘 전용으로 보여준다), 폭만 56px 로 줄인다. -->
        <Border Grid.Column="0" Background="#FAFBFC" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <!-- 앱 이름은 메뉴가 펼쳐졌을 때만 보여준다. (VS Code 레일도 앱 이름은 숨긴다) -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="HelperManager"
                               FontSize="18" FontWeight="Bold"
                               Margin="16,16,16,8"
                               Visibility="{Binding IsMenuExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!--
                        메뉴가 접혀 폭이 좁아지면(57px) 항목 내용이 그 폭을 살짝 넘을 수 있는데,
                        기본 ListBox는 가로 스크롤바(Auto)를 자동으로 보여준다. 이 화면에서는
                        가로 스크롤이 필요 없으므로 Disabled로 꺼서 "딱 떨어지게" 만든다.
                    -->
                    <ListBox ItemsSource="{Binding Modules}"
                             SelectedItem="{Binding SelectedModule}"
                             ItemTemplate="{StaticResource NavItemTemplate}"
                             ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0,8,0,0" />
                </DockPanel>

                <!-- 메뉴 접기/펼치기 토글 버튼이 있는 얇은 세로 띠. 메뉴가 접혀도 이 버튼은 항상 보인다. -->
                <Border Grid.Row="1" Background="#FAFBFC" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                    <Button Style="{StaticResource CollapseToggleButtonStyle}"
                            Command="{Binding ToggleMenuCommand}"
                            Margin="4,16,4,4"
                            VerticalAlignment="Top"
                            ToolTip="메뉴 접기/펼치기">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="◀" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMenuExpanded}" Value="False">
                                            <Setter Property="Text" Value="▶" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== 우측: 선택된 화면(모듈)의 본문 ===================== -->
        <!-- App.xaml 에 등록된 DataTemplate 에 따라, 선택된 모듈의 ViewModel 타입에 맞는 View 가 자동 표시된다. -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentContent}" Margin="16" />
    </Grid>
</Window>
