<UserControl x:Class="HelperManager.Modules.TableInfo.TableInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400">

    <UserControl.Resources>
        <!-- 본문의 네 패널(테이블/컬럼/인덱스/오브젝트) 머리글에 공통으로 쓰는 스타일 -->
        <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 상단: 파일 경로(접기) + 검색 툴바 -->
            <RowDefinition Height="*" />    <!-- 본문: 테이블(좌) + 컬럼/인덱스/오브젝트(우) -->
            <RowDefinition Height="Auto" /> <!-- 하단: 상태 메시지 -->
        </Grid.RowDefinitions>

        <!-- ===================== 상단 툴바 ===================== -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarBorderStyle}">
            <StackPanel>
                <!--
                    파일이 네 개라 경로 줄이 길어지므로 평소에는 접어두고, 경로를 바꿀 때만 펼친다.
                    (Settings 화면에 미리 등록해두면 시작할 때 자동으로 읽히므로 평소엔 열 일이 없다)
                -->
                <Expander Header="불러온 파일 경로 (TableInfo / ColumnInfo / IndexInfo / TableUseObjectList)"
                          IsExpanded="False"
                          Margin="0,0,0,8">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="TableInfo :" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,0"
                                 IsReadOnly="True" VerticalContentAlignment="Center"
                                 Text="{Binding TableInfoFilePath, Mode=OneWay}"
                                 ToolTip="테이블 목록(OWNER/TABLE_NAME/TABLE_COMMENTS) JSON 파일 경로입니다." />
                        <Button Grid.Row="0" Grid.Column="2" Content="파일 열기..." Command="{Binding OpenTableInfoFileCommand}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="ColumnInfo :" VerticalAlignment="Center" Margin="0,8,6,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,8,0"
                                 IsReadOnly="True" VerticalContentAlignment="Center"
                                 Text="{Binding ColumnInfoFilePath, Mode=OneWay}"
                                 ToolTip="컬럼 목록 JSON 파일 경로입니다." />
                        <Button Grid.Row="1" Grid.Column="2" Content="파일 열기..." Command="{Binding OpenColumnInfoFileCommand}" Margin="0,8,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="IndexInfo :" VerticalAlignment="Center" Margin="0,8,6,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,8,8,0"
                                 IsReadOnly="True" VerticalContentAlignment="Center"
                                 Text="{Binding IndexInfoFilePath, Mode=OneWay}"
                                 ToolTip="인덱스 목록 JSON 파일 경로입니다." />
                        <Button Grid.Row="2" Grid.Column="2" Content="파일 열기..." Command="{Binding OpenIndexInfoFileCommand}" Margin="0,8,0,0" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="UseObject :" VerticalAlignment="Center" Margin="0,8,6,0" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,8,0"
                                 IsReadOnly="True" VerticalContentAlignment="Center"
                                 Text="{Binding TableObjectFilePath, Mode=OneWay}"
                                 ToolTip="테이블을 사용 중인 오브젝트 목록 JSON 파일 경로입니다." />
                        <Button Grid.Row="3" Grid.Column="2" Content="파일 열기..." Command="{Binding OpenTableObjectFileCommand}" Margin="0,8,0,0" />
                    </Grid>
                </Expander>

                <!-- 검색 (OWNER / TABLE_NAME / TABLE_COMMENTS 중 하나라도 부분 일치) + 새로고침 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="검색 :" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <TextBox Grid.Column="1" Margin="0,0,8,0" VerticalContentAlignment="Center"
                             Text="{Binding FilterKeyword, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="OWNER / TABLE_NAME / TABLE_COMMENTS 중 하나라도 포함되어 있으면 보여줍니다." />

                    <Button Grid.Column="2" Content="새로고침" Command="{Binding RefreshCommand}"
                            ToolTip="정기적으로 갱신되는 네 파일을 디스크에서 다시 읽어옵니다." />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===================== 본문 ===================== -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" MinWidth="450" />
            </Grid.ColumnDefinitions>

            <!-- 좌측: 테이블 목록 (Owner / Table / Table Comments) -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeaderStyle}" Text="Table Info" />

                    <DataGrid ItemsSource="{Binding FilteredTables}"
                              SelectedItem="{Binding SelectedTable}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="OWNER" Binding="{Binding Owner}" Width="80" />
                            <DataGridTextColumn Header="TABLE_NAME" Binding="{Binding TableName}" Width="130" />
                            <DataGridTextColumn Header="TABLE_COMMENTS" Binding="{Binding TableComments}" Width="*" MinWidth="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- 우측: 선택한 테이블의 컬럼 / 인덱스 / 사용 오브젝트 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="120" /> <!-- 컬럼 -->
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" MinHeight="80" />   <!-- 인덱스 -->
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" MinHeight="80" />   <!-- 사용 오브젝트 -->
                </Grid.RowDefinitions>

                <!-- 컬럼 목록 (Column / data type / nullable / DEFAULT / Comment) -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeaderStyle}" Text="Column Info" />

                        <DataGrid ItemsSource="{Binding Columns}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="COL_NAME" Binding="{Binding ColName}" Width="160" />
                                <DataGridTextColumn Header="DATATYPE" Binding="{Binding DataType}" Width="130" />
                                <DataGridTextColumn Header="NULLABLE" Binding="{Binding Nullable}" Width="80" />
                                <DataGridTextColumn Header="DEFAULT" Binding="{Binding DefaultValue}" Width="120" />
                                <DataGridTextColumn Header="COMMENTS" Binding="{Binding Comments}" Width="*" MinWidth="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

                <!-- 인덱스 목록 (Index name / column / comment) -->
                <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeaderStyle}" Text="Index Info" />

                        <DataGrid ItemsSource="{Binding Indexes}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="INDEX_NAME" Binding="{Binding IndexName}" Width="180" />
                                <DataGridTextColumn Header="COLUMN" Binding="{Binding ColumnName}" Width="220" />
                                <DataGridTextColumn Header="COMMENTS" Binding="{Binding Comments}" Width="*" MinWidth="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

                <!-- 이 테이블을 사용 중인 오브젝트 (Owner / OBJ NAME / OBJ TYPE / STATUS) -->
                <Border Grid.Row="4" Style="{StaticResource PanelBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeaderStyle}" Text="Use Object" />

                        <!--
                            현재 추출 쿼리는 참조 대상 테이블을 내보내지 않아, 어떤 테이블이 쓰는
                            오브젝트인지 알 수 없다. 그럴 때는 빈 표 대신 고치는 방법을 안내한다.
                        -->
                        <TextBlock DockPanel.Dock="Top"
                                   Foreground="#B45309"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"
                                   Visibility="{Binding IsObjectJoinUnavailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Text="이 파일에는 참조 대상 테이블 컬럼이 없어 선택한 테이블로 걸러낼 수 없습니다. 추출 쿼리에 a.referenced_name(트리거는 a.table_name)을 TABLE_NAME 으로 추가해 주세요." />

                        <DataGrid ItemsSource="{Binding Objects}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="OWNER" Binding="{Binding Owner}" Width="80" />
                                <DataGridTextColumn Header="OBJ_NAME" Binding="{Binding ObjName}" Width="220" />
                                <DataGridTextColumn Header="OBJ_TYPE" Binding="{Binding ObjType}" Width="120" />
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*" MinWidth="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===================== 하단 상태 메시지 ===================== -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="Gray" />
    </Grid>
</UserControl>
