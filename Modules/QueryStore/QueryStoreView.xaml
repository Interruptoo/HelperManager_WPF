<UserControl x:Class="HelperManager.Modules.QueryStore.QueryStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:common="clr-namespace:HelperManager.Common"
             xmlns:models="clr-namespace:HelperManager.Modules.QueryStore.Models"
             xmlns:local="clr-namespace:HelperManager.Modules.QueryStore"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 상단: 파일 열기 + 검색 툴바 -->
            <RowDefinition Height="*" />    <!-- 본문: 트리(공용) + 열려 있는 쿼리 탭들 -->
            <RowDefinition Height="Auto" /> <!-- 하단: 상태 메시지 -->
        </Grid.RowDefinitions>

        <!--
            ===================== 상단 툴바: 검색 + 새로고침 =====================
            쿼리 모음 XML 경로는 Settings 화면에 등록해두고 시작할 때 자동으로 읽으므로
            [파일 열기]와 경로 입력란은 두지 않는다.

            다만 [새로고침]은 남긴다. 다른 화면이 보는 JSON 과 달리 이 XML 은 EQS 에서 따로 받아오는
            파일이라, Settings 의 [지금 추출]로 갱신되지 않기 때문이다.
        -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 쿼리 id / 쿼리 내용으로 트리에서 찾기 (라디오 버튼으로 검색 대상 분리) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="검색 :" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <TextBox Grid.Column="1" VerticalContentAlignment="Center"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Enter 또는 [검색]을 누르면 선택된 대상(쿼리 id / 쿼리 내용)에서 찾습니다.">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                        <RadioButton GroupName="QuerySearchScope"
                                     Content="쿼리 ID"
                                     IsChecked="{Binding SearchById}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0" />
                        <RadioButton GroupName="QuerySearchScope"
                                     Content="쿼리 내용"
                                     IsChecked="{Binding SearchByContent}"
                                     VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="3" Content="검색 (다음 찾기)" Command="{Binding SearchCommand}" Margin="10,0,0,0" />

                    <TextBlock Grid.Column="4"
                               Text="{Binding SearchStatusText}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               MinWidth="90" />

                    <Button Grid.Column="5" Content="새로고침" Command="{Binding RefreshCommand}"
                            Margin="10,0,0,0"
                            ToolTip="EQS에서 쿼리 모음 XML을 새로 받았을 때 누르세요. 디스크에서 다시 읽습니다. (열려 있던 쿼리 탭은 모두 닫힙니다)" />
                </Grid>
            </Grid>
        </Border>

        <!-- ===================== 본문: 트리(좌) + 상세 내용(우) ===================== -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="240" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- 좌측: 쿼리 id 트리 (탭과 달리 화면 전체에서 공용으로 하나만 사용한다) -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <TreeView x:Name="QueryTree"
                          ItemsSource="{Binding RootNodes}"
                          BorderThickness="0"
                          SelectedItemChanged="QueryTree_OnSelectedItemChanged"
                          MouseDoubleClick="QueryTree_OnMouseDoubleClick">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type models:QueryTreeNode}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="18" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="📁" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                    <Setter Property="Text" Value="📄" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="common:TreeViewItemBehavior.AutoBringIntoView" Value="True" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!--
                우측: 열려 있는 쿼리 탭들. 트리에서 쿼리를 더블클릭(또는 검색)할 때마다 탭이 하나씩
                열리고, 탭 하나하나가 QUERY TEXT + PARAMETERS + 미리보기를 전부 포함한다.
                TabControl.ContentTemplate 하나로 모든 탭의 본문 모양을 정의한다.
            -->
            <TabControl Grid.Column="2" ItemsSource="{Binding OpenTabs}" SelectedItem="{Binding SelectedTab}">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:QueryTabViewModel}">
                        <!--
                            Tag 에 QueryStoreViewModel 을 담아두는 이유:
                            ContextMenu 는 화면의 시각 트리(visual tree) 바깥에 떠서 열리기 때문에
                            RelativeSource AncestorType 으로 TabControl 을 거슬러 올라갈 수 없다.
                            대신 ContextMenu 의 PlacementTarget(= 이 StackPanel)을 통해 Tag 를 읽는 방식으로
                            화면 전체 ViewModel 의 커맨드에 접근한다.
                            (이 StackPanel 자체는 시각 트리 안에 있으므로 여기서는 Ancestor 탐색이 된다)
                        -->
                        <StackPanel Orientation="Horizontal"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}">
                            <StackPanel.ContextMenu>
                                <!-- ContextMenu 의 DataContext 는 이 탭(QueryTabViewModel)이 된다. -->
                                <ContextMenu>
                                    <MenuItem Header="닫기" Command="{Binding CloseCommand}" />

                                    <MenuItem Header="다른 탭 모두 닫기"
                                              Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />

                                    <Separator />

                                    <MenuItem Header="모두 닫기"
                                              Command="{Binding PlacementTarget.Tag.CloseAllTabsCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </StackPanel.ContextMenu>

                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Style="{StaticResource CollapseToggleButtonStyle}"
                                    Command="{Binding CloseCommand}"
                                    Width="18" Height="18"
                                    FontSize="10" FontWeight="Normal"
                                    Content="✕"
                                    ToolTip="탭 닫기" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type local:QueryTabViewModel}">
                        <Grid Margin="10,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="380" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="320" MinWidth="240" />
                            </Grid.ColumnDefinitions>

                            <!-- QUERY TEXT: 이 탭이 보여주는 쿼리의 원본 텍스트(색상 강조) -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{Binding Query.Id}" FontWeight="Bold" Margin="0,0,0,8" />

                                <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                                    <RichTextBox IsReadOnly="True"
                                                 IsDocumentEnabled="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 common:SqlHighlightBehavior.SqlText="{Binding DetailText}" />
                                </Border>
                            </Grid>

                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                            <!--
                                PARAMETERS / 미리보기: DB 연결 없이, 쿼리 본문의 :NAME 바인드 변수에 값을
                                입력받아 치환이 끝난 순수 SQL을 클립보드로 복사해서 DBMS 도구에 붙여넣어
                                실행하기 위한 영역.
                            -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="100" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="PARAMETERS" FontWeight="Bold" VerticalAlignment="Center" />

                                    <Button Grid.Column="1"
                                            Content="클립보드에서 채우기"
                                            Command="{Binding FillParametersFromClipboardCommand}"
                                            ToolTip="요청 로그 뷰어(RequestInfo)에서 복사한 RequestContent/ResponseContent 내용을 붙여넣어, 이름이 같은 파라미터에 값을 자동으로 채웁니다." />
                                </Grid>

                                <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                                    <DataGrid ItemsSource="{Binding Parameters}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              SelectionUnit="FullRow"
                                              Height="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="파라미터명" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                                            <DataGridTextColumn Header="값" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                            <DataGridComboBoxColumn Header="타입"
                                                                     ItemsSource="{x:Static models:QueryParameterItem.AllValueTypes}"
                                                                     SelectedItemBinding="{Binding ValueType}"
                                                                     Width="72" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <Button Grid.Row="2"
                                        Content="클립보드 복사"
                                        Command="{Binding CopyToClipboardCommand}"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Stretch"
                                        ToolTip="XML 태그/주석과 iBatis 조건 태그를 처리하고, 입력한 값으로 바인드 변수를 치환한 SQL을 클립보드에 복사합니다." />

                                <TextBlock Grid.Row="3" Text="복사 결과 미리보기" FontWeight="Bold" Margin="0,12,0,8" />

                                <Border Grid.Row="4" Style="{StaticResource PanelBorderStyle}">
                                    <RichTextBox IsReadOnly="True"
                                                 IsDocumentEnabled="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 common:SqlHighlightBehavior.SqlText="{Binding ClipboardPreviewText}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>

        <!-- ===================== 하단 상태 메시지 ===================== -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="Gray" />
    </Grid>
</UserControl>
