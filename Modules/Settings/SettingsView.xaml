<UserControl x:Class="HelperManager.Modules.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <!-- 등록할 경로가 늘어나 화면보다 길어질 수 있으므로 전체를 세로 스크롤로 감싼다. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 제목 -->
            <RowDefinition Height="Auto" /> <!-- Request LogViewer 자동 로드 폴더 -->
            <RowDefinition Height="Auto" /> <!-- Query Store 자동 로드 XML -->
            <RowDefinition Height="Auto" /> <!-- MenuInfo 자동 로드 JSON -->
            <RowDefinition Height="Auto" /> <!-- Common Code 자동 로드 JSON(2개) -->
            <RowDefinition Height="Auto" /> <!-- Table Info 자동 로드 JSON(4개) -->
            <RowDefinition Height="*" />    <!-- 여백 -->
            <RowDefinition Height="Auto" /> <!-- 저장 버튼 + 상태 메시지 -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

        <!-- Request LogViewer: 시작 시 자동으로 열 폴더(여러 개) -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Request LogViewer - 시작 시 자동으로 열 폴더" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Text="여러 개 등록하면 등록한 순서대로 Tab1, Tab2, ... 가 자동으로 만들어집니다."
                           Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />

                <ListBox ItemsSource="{Binding RequestLogViewerFolderPaths}"
                         Height="160"
                         BorderThickness="1"
                         BorderBrush="{StaticResource Brush.Border}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />

                                <Button Grid.Column="1"
                                        Content="삭제"
                                        Padding="8,2"
                                        Margin="8,0,0,0"
                                        Command="{Binding DataContext.RemoveLogFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="+ 폴더 추가"
                        Command="{Binding AddLogFolderCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Query Store: 시작 시 자동으로 불러올 XML 파일 하나 -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Query Store - 시작 시 자동으로 불러올 쿼리 모음 XML" FontWeight="Bold" Margin="0,0,0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Text="{Binding QueryStoreXmlPath, Mode=OneWay}" />

                    <Button Grid.Column="1" Content="파일 선택..." Command="{Binding BrowseQueryStoreXmlCommand}" Margin="8,0,0,0" />
                    <Button Grid.Column="2" Content="지우기" Command="{Binding ClearQueryStoreXmlCommand}" Margin="8,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- MenuInfo: 시작 시 자동으로 불러올 메뉴 정보 JSON 파일 하나 -->
        <Border Grid.Row="3" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Menu Info - 시작 시 자동으로 불러올 메뉴 정보 JSON" FontWeight="Bold" Margin="0,0,0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Text="{Binding MenuInfoJsonPath, Mode=OneWay}" />

                    <Button Grid.Column="1" Content="파일 선택..." Command="{Binding BrowseMenuInfoJsonCommand}" Margin="8,0,0,0" />
                    <Button Grid.Column="2" Content="지우기" Command="{Binding ClearMenuInfoJsonCommand}" Margin="8,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Common Code: 시작 시 자동으로 불러올 ComnCdInfo.json / ComnCdDetail.json -->
        <Border Grid.Row="4" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Common Code - 시작 시 자동으로 불러올 공통코드 JSON" FontWeight="Bold" Margin="0,0,0,8" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="ComnCdInfo :" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <TextBox Grid.Column="1"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Text="{Binding ComnCdInfoPath, Mode=OneWay}" />

                    <Button Grid.Column="2" Content="파일 선택..." Command="{Binding BrowseComnCdInfoCommand}" Margin="8,0,0,0" />
                    <Button Grid.Column="3" Content="지우기" Command="{Binding ClearComnCdInfoCommand}" Margin="8,0,0,0" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="ComnCdDetail :" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <TextBox Grid.Column="1"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Text="{Binding ComnCdDetailPath, Mode=OneWay}" />

                    <Button Grid.Column="2" Content="파일 선택..." Command="{Binding BrowseComnCdDetailCommand}" Margin="8,0,0,0" />
                    <Button Grid.Column="3" Content="지우기" Command="{Binding ClearComnCdDetailCommand}" Margin="8,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Table Info: 시작 시 자동으로 불러올 테이블/컬럼/인덱스/사용오브젝트 JSON 4개 -->
        <Border Grid.Row="5" Style="{StaticResource PanelBorderStyle}">
            <StackPanel>
                <TextBlock Text="Table Info - 시작 시 자동으로 불러올 테이블 명세 JSON" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Text="네 파일은 서로 독립적이라, 가지고 있는 것만 등록해도 그 목록만 채워집니다."
                           Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="TableInfo :" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center"
                             Text="{Binding TableInfoJsonPath, Mode=OneWay}" />
                    <Button Grid.Row="0" Grid.Column="2" Content="파일 선택..." Command="{Binding BrowseTableInfoJsonCommand}" Margin="8,0,0,0" />
                    <Button Grid.Row="0" Grid.Column="3" Content="지우기" Command="{Binding ClearTableInfoJsonCommand}" Margin="8,0,0,0" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="ColumnInfo :" VerticalAlignment="Center" Margin="0,8,6,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,8,0,0"
                             Text="{Binding ColumnInfoJsonPath, Mode=OneWay}" />
                    <Button Grid.Row="1" Grid.Column="2" Content="파일 선택..." Command="{Binding BrowseColumnInfoJsonCommand}" Margin="8,8,0,0" />
                    <Button Grid.Row="1" Grid.Column="3" Content="지우기" Command="{Binding ClearColumnInfoJsonCommand}" Margin="8,8,0,0" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="IndexInfo :" VerticalAlignment="Center" Margin="0,8,6,0" />
                    <TextBox Grid.Row="2" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,8,0,0"
                             Text="{Binding IndexInfoJsonPath, Mode=OneWay}" />
                    <Button Grid.Row="2" Grid.Column="2" Content="파일 선택..." Command="{Binding BrowseIndexInfoJsonCommand}" Margin="8,8,0,0" />
                    <Button Grid.Row="2" Grid.Column="3" Content="지우기" Command="{Binding ClearIndexInfoJsonCommand}" Margin="8,8,0,0" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="UseObject :" VerticalAlignment="Center" Margin="0,8,6,0" />
                    <TextBox Grid.Row="3" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,8,0,0"
                             Text="{Binding TableUseObjectJsonPath, Mode=OneWay}" />
                    <Button Grid.Row="3" Grid.Column="2" Content="파일 선택..." Command="{Binding BrowseTableUseObjectJsonCommand}" Margin="8,8,0,0" />
                    <Button Grid.Row="3" Grid.Column="3" Content="지우기" Command="{Binding ClearTableUseObjectJsonCommand}" Margin="8,8,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 저장 -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="저장" Command="{Binding SaveCommand}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</UserControl>
