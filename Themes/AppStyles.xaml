<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        외부 UI 라이브러리 없이 순수 WPF 리소스만으로 만든 기본 테마입니다.
        간결한 플랫(Flat) 디자인을 지향하며, 색상만 바꾸면 전체 톤을 쉽게 조정할 수 있도록
        모든 색상을 상단에 브러시 리소스로 선언해두었습니다.
        추후 Material/Fluent 계열 UI 킷으로 교체하고 싶다면 이 파일만 교체하면 됩니다.
    -->

    <!-- ===================== 색상 팔레트 ===================== -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.AccentDark" Color="#1D4ED8" />
    <SolidColorBrush x:Key="Brush.Background" Color="#F5F6F8" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#DDE1E6" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1F2328" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#6B7280" />
    <SolidColorBrush x:Key="Brush.NavSelected" Color="#EAF1FF" />

    <!-- ===================== 공통 레이아웃 스타일 ===================== -->

    <!-- 상단 툴바(폴더/파일 선택 등)를 감싸는 패널 스타일 -->
    <Style x:Key="ToolbarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- 목록/상세 등 본문 영역을 감싸는 패널 스타일 -->
    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- ===================== 기본 컨트롤 스타일 ===================== -->

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Brush.Background}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.AccentDark}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="RowBackground" Value="{StaticResource Brush.Surface}" />
        <Setter Property="AlternatingRowBackground" Value="#FAFBFC" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F1F3F5" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!--
        가로 접기/펼치기 토글 버튼(메인 메뉴, Query Store 파라미터 패널 등) 전용 스타일.
        일반 Button 스타일(파란 배경의 큰 버튼)과 달리, 작고 동그란 "칩" 모양으로 만들어
        은은하지만 눈에 띄게 하고, 마우스를 올리면 강조색으로 바뀌어 클릭 가능함을 분명히 보여준다.
    -->
    <Style x:Key="CollapseToggleButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ToggleBorder"
                            Background="{StaticResource Brush.NavSelected}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="14"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Brush.AccentDark}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
